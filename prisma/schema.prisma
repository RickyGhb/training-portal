// Training Portal — Prisma schema
// See Training_Website/Technical Implementation Blueprint.md for the source spec
// and .claude/plans/i-m-planning-to-build-dreamy-floyd.md for the resolved decisions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CEO
  LOCATION_MANAGER
  LOCATION_ADMIN
  COORDINATOR
  CONSULTANT
  OFFSHORE_MANAGER
  OFFSHORE_TEAM_LEAD
  TRAINER
  OTTER_TEAM
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  DELETED
}

enum ContentStatus {
  ACTIVE
  ARCHIVED
}

enum AuditActionType {
  USER_CREATED
  USERNAME_CHANGED
  PASSWORD_RESET
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_DELETED
  TRAINING_PATH_ASSIGNED
  TRAINING_PATH_CHANGED
  EXTRA_COURSE_ASSIGNED
  EXTRA_COURSE_REMOVED
  CONSULTANT_REASSIGNED
  CONSULTANTS_BULK_REASSIGNED
  LOCATION_CREATED
  LOCATION_UPDATED
  TRAINING_PATH_CREATED
  TRAINING_PATH_UPDATED
  TRAINING_PATH_DELETED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DELETED
  VIDEO_CREATED
  VIDEO_UPDATED
  VIDEO_DELETED
  REPORT_EXPORTED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  PROFILE_CHANGE_REQUESTED
  PROFILE_UPDATED
  TRAINER_FEEDBACK_SUBMITTED
  OTTER_FEEDBACK_SUBMITTED
  MARKETING_STATUS_CHANGED
  TEAM_LEAD_REASSIGNED
  FORM_CREATED
  FORM_UPDATED
  FORM_DELETED
  FORM_SUBMITTED
}

enum NotificationType {
  REPORT_EXPORTED
  PASSWORD_RESET
  USER_DELETED
  PROFILE_CHANGE_REQUESTED
  MARKETING_READY
}

// Unrelated to the Location model/hierarchy — a separate, fixed classification
// used only at consultant-creation time (for now).
enum OffshoreOffice {
  LOCATION_1
  LOCATION_2
}

enum VisaType {
  CPT
  INITIAL_OPT
  STEM_OPT
  H1B
  H4EAD
  GC
  US_CITIZEN
}

enum MarketingStatus {
  IN_TRAINING
  IN_MARKETING
}

enum FeedbackVerdict {
  READY
  NOT_READY
}

enum FormFieldType {
  SHORT_TEXT
  PARAGRAPH
  DATE
  DROPDOWN
  MULTIPLE_CHOICE
  CHECKBOXES
  FILE_UPLOAD
}

enum FormFieldOptionsSource {
  CUSTOM // options come from FormFieldOption rows
  LOCATIONS // options computed live from the Location table
  TECHNOLOGIES // options computed live from TECHNOLOGY_OPTIONS
}

model Location {
  id              String        @id @default(cuid())
  name            String
  code            String        @unique
  status          ContentStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?         @relation("LocationCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users           User[]           @relation("UserLocation")
  auditLogs       AuditLog[]
  formSubmissions FormSubmission[]

  @@index([status])
}

model User {
  id            String     @id @default(cuid())
  role          Role
  firstName     String
  lastName      String
  username      String     @unique
  usernameLower String     @unique // enforced-lowercase mirror for case-insensitive uniqueness
  passwordHash  String
  email         String?
  phone         String?
  status        UserStatus @default(ACTIVE)

  locationId String?
  location   Location? @relation("UserLocation", fields: [locationId], references: [id])

  managerId    String?
  manager      User?   @relation("ManagerToUsers", fields: [managerId], references: [id])
  managedUsers User[]  @relation("ManagerToUsers")

  locationManagerId        String?
  locationManager          User?   @relation("LocationManagerToUsers", fields: [locationManagerId], references: [id])
  managedByLocationManager User[]  @relation("LocationManagerToUsers")

  coordinatorId      String?
  coordinator        User?   @relation("CoordinatorToConsultants", fields: [coordinatorId], references: [id])
  managedConsultants User[]  @relation("CoordinatorToConsultants")

  // Offshore Team Lead -> Consultant, assigned by the Offshore Manager. Separate
  // axis from coordinatorId — a Consultant can have both a Coordinator and an
  // Offshore Team Lead simultaneously.
  offshoreTeamLeadId String?
  offshoreTeamLead   User?   @relation("TeamLeadToConsultants", fields: [offshoreTeamLeadId], references: [id])
  managedByTeamLead  User[]  @relation("TeamLeadToConsultants")

  // Trainer -> Consultant, one assigned Trainer per Consultant.
  trainerUserId String?
  trainer       User?   @relation("TrainerToConsultants", fields: [trainerUserId], references: [id])
  trainees      User[]  @relation("TrainerToConsultants")

  // Otter Team -> Consultant, one assigned Otter Team reviewer per Consultant.
  otterTeamUserId String?
  otterTeamUser   User?   @relation("OtterTeamToConsultants", fields: [otterTeamUserId], references: [id])
  otterCaseload   User[]  @relation("OtterTeamToConsultants")

  // Separate from locationId/the Location model — see OffshoreOffice enum comment.
  // Also reused (not renamed) for the Offshore Manager's/Team Lead's own office
  // assignment — same enum, same field, different meaning depending on role.
  offshoreOffice OffshoreOffice?

  // Self-service Calendly link, set by a Trainer or Coordinator for Consultants
  // to book demo slots against. Null for every other role.
  calendlyLink String?

  // Consultant-only readiness status, flipped once both Trainer and Otter Team
  // feedback verdicts are READY. See evaluateMarketingReadiness().
  marketingStatus MarketingStatus @default(IN_TRAINING)

  // Plain string, not an enum (unlike OffshoreOffice) — this list keeps
  // growing and includes arbitrary free text via an "Other" option.
  technology String?

  visaType    VisaType?
  dateOfBirth DateTime? @db.Date

  createdByUserId String?
  createdBy       User?   @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers    User[]  @relation("UserCreatedBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdLocations      Location[]                     @relation("LocationCreatedBy")
  trainingAssignment    ConsultantTrainingAssignment?  @relation("ConsultantAssignment")
  assignedTrainingPaths ConsultantTrainingAssignment[] @relation("AssignedByUser")
  extraCourses          ConsultantExtraCourse[]        @relation("ConsultantExtraCourses")
  assignedExtraCourses  ConsultantExtraCourse[]        @relation("ExtraCourseAssignedBy")
  videoCompletions      VideoCompletion[]              @relation("ConsultantCompletions")
  markedCompletions     VideoCompletion[]              @relation("MarkedByUser")
  sessions              Session[]
  auditLogsAsActor      AuditLog[]                     @relation("AuditActor")
  auditLogsAsTarget     AuditLog[]                     @relation("AuditTargetUser")
  notifications         Notification[]
  createdTrainingPaths  TrainingPath[]                 @relation("TrainingPathCreatedBy")
  createdCourses        Course[]                       @relation("CourseCreatedBy")
  createdVideos         Video[]                        @relation("VideoCreatedBy")
  updatedVideos         Video[]                        @relation("VideoUpdatedBy")
  createdForms          Form[]                         @relation("FormCreatedBy")
  formAccessGranted     FormAccessGrant[]              @relation("FormAccessGrantee")
  formAccessGivenByMe   FormAccessGrant[]              @relation("FormAccessGrantor")

  trainerFeedbackReceived TrainerFeedback[] @relation("TrainerFeedbackConsultant")
  trainerFeedbackGiven    TrainerFeedback[] @relation("TrainerFeedbackTrainer")
  otterFeedbackReceived   OtterFeedback[]   @relation("OtterFeedbackConsultant")
  otterFeedbackGiven      OtterFeedback[]   @relation("OtterFeedbackOtterUser")

  @@index([role])
  @@index([role, deletedAt])
  @@index([locationId])
  @@index([coordinatorId])
  @@index([managerId])
  @@index([locationManagerId])
  @@index([status])
  @@index([offshoreTeamLeadId])
  @@index([trainerUserId])
  @@index([otterTeamUserId])
  @@index([offshoreOffice])
  @@index([marketingStatus])
}

model TrainingPath {
  id              String        @id @default(cuid())
  name            String
  description     String?
  technology      String?
  status          ContentStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?         @relation("TrainingPathCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  courses     TrainingPathCourse[]
  assignments ConsultantTrainingAssignment[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([technology])
}

model Course {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ContentStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?         @relation("CourseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trainingPaths    TrainingPathCourse[]
  videos           CourseVideo[]
  extraAssignments ConsultantExtraCourse[]
  auditLogs        AuditLog[]

  @@index([status])
}

model Video {
  id              String        @id @default(cuid())
  title           String
  description     String?
  driveSourceUrl  String
  driveFileId     String        @unique
  embedUrl        String
  thumbnailUrl    String?
  durationSeconds Int?
  status          ContentStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?         @relation("VideoCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?         @relation("VideoUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  courses     CourseVideo[]
  completions VideoCompletion[]
  auditLogs   AuditLog[]

  @@index([status])
}

model TrainingPathCourse {
  id             String       @id @default(cuid())
  trainingPathId String
  trainingPath   TrainingPath @relation(fields: [trainingPathId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  @@unique([trainingPathId, courseId])
  @@index([courseId])
}

model CourseVideo {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  @@unique([courseId, videoId])
  @@index([videoId])
}

model ConsultantTrainingAssignment {
  id               String       @id @default(cuid())
  consultantUserId String       @unique
  consultant       User         @relation("ConsultantAssignment", fields: [consultantUserId], references: [id], onDelete: Cascade)
  trainingPathId   String
  trainingPath     TrainingPath @relation(fields: [trainingPathId], references: [id])
  assignedByUserId String?
  assignedBy       User?        @relation("AssignedByUser", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime     @default(now())

  @@index([trainingPathId])
}

model ConsultantExtraCourse {
  id               String   @id @default(cuid())
  consultantUserId String
  consultant       User     @relation("ConsultantExtraCourses", fields: [consultantUserId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedByUserId String?
  assignedBy       User?    @relation("ExtraCourseAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())

  @@unique([consultantUserId, courseId])
  @@index([courseId])
}

model VideoCompletion {
  id               String   @id @default(cuid())
  consultantUserId String
  consultant       User     @relation("ConsultantCompletions", fields: [consultantUserId], references: [id], onDelete: Cascade)
  videoId          String
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  completedAt      DateTime @default(now())
  markedByUserId   String?
  markedBy         User?    @relation("MarkedByUser", fields: [markedByUserId], references: [id])

  @@unique([consultantUserId, videoId])
  @@index([videoId])
}

model TrainerFeedback {
  id               String          @id @default(cuid())
  consultantUserId String
  consultant       User            @relation("TrainerFeedbackConsultant", fields: [consultantUserId], references: [id], onDelete: Cascade)
  trainerUserId    String
  trainer          User            @relation("TrainerFeedbackTrainer", fields: [trainerUserId], references: [id])
  verdict          FeedbackVerdict
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([consultantUserId])
  @@index([trainerUserId])
}

model OtterFeedback {
  id               String          @id @default(cuid())
  consultantUserId String
  consultant       User            @relation("OtterFeedbackConsultant", fields: [consultantUserId], references: [id], onDelete: Cascade)
  otterUserId      String
  otterUser        User            @relation("OtterFeedbackOtterUser", fields: [otterUserId], references: [id])
  verdict          FeedbackVerdict
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([consultantUserId])
  @@index([otterUserId])
}

model Form {
  id              String        @id @default(cuid())
  title           String
  description     String?
  slug            String        @unique // public URL: /f/{slug}
  status          ContentStatus @default(ACTIVE)
  createdByUserId String?
  createdBy       User?         @relation("FormCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  fields       FormField[]
  submissions  FormSubmission[]
  accessGrants FormAccessGrant[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([createdByUserId])
}

model FormField {
  id              String                 @id @default(cuid())
  formId          String
  form            Form                   @relation(fields: [formId], references: [id], onDelete: Cascade)
  label           String
  helpText        String?
  type            FormFieldType
  required        Boolean                @default(false)
  sortOrder       Int                    @default(0)
  optionsSource   FormFieldOptionsSource @default(CUSTOM)
  // File-upload-only config (null for other types):
  maxFiles        Int?
  maxFileSizeMb   Int?
  // Marks this field as the one whose answer resolves a submission's Location
  // (drives location-based visibility) — only meaningful when optionsSource = LOCATIONS.
  isLocationField Boolean                @default(false)

  options FormFieldOption[]
  answers FormAnswer[]
  files   FormFileUpload[]

  @@index([formId])
}

model FormFieldOption {
  id        String    @id @default(cuid())
  fieldId   String
  field     FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int       @default(0)

  @@index([fieldId])
}

model FormSubmission {
  id           String    @id @default(cuid())
  formId       String
  form         Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  locationId   String? // resolved from the isLocationField answer, if present
  location     Location? @relation(fields: [locationId], references: [id])
  submittedAt  DateTime  @default(now())
  respondentIp String?

  answers FormAnswer[]
  files   FormFileUpload[]

  @@index([formId])
  @@index([locationId])
  @@index([formId, submittedAt])
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField      @relation(fields: [fieldId], references: [id])
  valueText    String? // single-value answer types
  valueJson    Json? // CHECKBOXES (multi-select)

  @@index([submissionId])
}

model FormFileUpload {
  id              String         @id @default(cuid())
  submissionId    String
  submission      FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId         String
  field           FormField      @relation(fields: [fieldId], references: [id])
  fileName        String
  storagePathname String // Vercel Blob pathname — never expose as a public URL, see access control
  fileSizeBytes   Int
  mimeType        String
  uploadedAt      DateTime       @default(now())

  @@index([submissionId])
  @@index([fieldId])
}

model FormAccessGrant {
  id              String   @id @default(cuid())
  formId          String
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  grantedToUserId String
  grantedTo       User     @relation("FormAccessGrantee", fields: [grantedToUserId], references: [id])
  grantedByUserId String
  grantedBy       User     @relation("FormAccessGrantor", fields: [grantedByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([formId, grantedToUserId])
  @@index([grantedToUserId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model AuditLog {
  id               String          @id @default(cuid())
  actorUserId      String?
  actor            User?           @relation("AuditActor", fields: [actorUserId], references: [id])
  actionType       AuditActionType
  targetEntityType String
  targetEntityId   String?
  targetUserId     String?
  targetUser       User?           @relation("AuditTargetUser", fields: [targetUserId], references: [id])
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id])
  trainingPathId   String?
  trainingPath     TrainingPath?   @relation(fields: [trainingPathId], references: [id])
  courseId         String?
  course           Course?         @relation(fields: [courseId], references: [id])
  videoId          String?
  video            Video?          @relation(fields: [videoId], references: [id])
  formId           String?
  form             Form?           @relation(fields: [formId], references: [id])
  metadataJson     Json?
  createdAt        DateTime        @default(now())

  notifications Notification[]

  @@index([actorUserId])
  @@index([actionType])
  @@index([createdAt])
  @@index([actionType, createdAt])
}

model Notification {
  id               String           @id @default(cuid())
  recipientUserId  String
  recipient        User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  body             String
  isRead           Boolean          @default(false)
  sourceAuditLogId String?
  sourceAuditLog   AuditLog?        @relation(fields: [sourceAuditLogId], references: [id])
  createdAt        DateTime         @default(now())

  @@index([recipientUserId, isRead])
}
